# Copy to .env and fill in. .env is gitignored and never reaches the exported workflow.

# GitHub personal access token (classic is fine; no scopes needed for public repos).
# Not optional: /stargazers returns 401 with no token at all, unlike /users which still
# serves anonymous requests. A token also lifts the quota from 60 to 5,000 requests/hour.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The repo whose stargazers we watch, as owner/name.
GITHUB_REPO=fastapi/fastapi

# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxxxxxx

# Local mission-control dashboard. The workflow posts telemetry here; it is fire-and-forget,
# so the pipeline keeps working when the dashboard is not running.
DASHBOARD_URL=http://localhost:8787

# --- Tuning ------------------------------------------------------------------
# Hard qualification gate, per the assignment: followers > 100 OR public_repos > 50.
MIN_FOLLOWERS=100
MIN_REPOS=50

# Most enrichment calls we are willing to make in a single poll. Caps the blast radius
# of a viral spike; the overflow is picked up by the next poll.
MAX_ENRICH_PER_RUN=20

# n8n only persists workflow static data for PRODUCTION runs, never for manual ones, so
# every "Test workflow" click cold-starts with an empty cursor. This tighter cap keeps a
# manual demo run to a readable handful of alerts instead of a wall of duplicates.
COLD_START_MAX_LEADS=3

# Stop the run when the GitHub quota drops below this many requests, so a concurrent
# job sharing the token can never push us to a hard zero mid-flight.
RATE_LIMIT_RESERVE=250

# On the very first run there is no cursor. Look back this far instead of replaying
# every stargazer the repo has ever had.
BOOTSTRAP_LOOKBACK_HOURS=24
